    <dialog class="budget-dialog" id="budget-dialog" aria-labelledby="budget-dialog-title">
      <div class="budget-dialog-panel">
        <button class="budget-dialog-close" type="button" aria-label="Cerrar formulario">×</button>
        <p class="section-label">Presupuesto sin compromiso</p>
        <h2 id="budget-dialog-title">Cuéntanos qué necesitas</h2>
        <p class="budget-dialog-copy">Déjanos tus datos y nos pondremos en contacto contigo para preparar un presupuesto a medida.</p>

        <form class="contact-form budget-dialog-form" action="mailto:info@limpama.es" method="post" enctype="text/plain">
          <div class="form-field">
            <label for="modal-nombre">Nombre</label>
            <input id="modal-nombre" name="nombre" type="text" autocomplete="name" placeholder="Tu nombre" required />
          </div>
          <div class="form-field">
            <label for="modal-email">Email</label>
            <input id="modal-email" name="email" type="email" autocomplete="email" placeholder="tu@email.com" required />
          </div>
          <div class="form-field">
            <label for="modal-servicio">Servicio en el que estás interesado</label>
            <select id="modal-servicio" name="servicio" required>
              <option value="Jardinería">Jardinería</option>
              <option value="Piscinas">Piscinas</option>
              <option value="Poda de palmeras">Poda de palmeras</option>
              <option value="Fontanería">Fontanería</option>
              <option value="Mantenimiento de comunidades">Mantenimiento de comunidades</option>
              <option value="Desatoros">Desatoros</option>
              <option value="Otros">Otros</option>
            </select>
          </div>
          <button type="submit">Solicitar presupuesto <span aria-hidden="true">→</span></button>
        </form>
      </div>
    </dialog>

    <script>
      const budgetDialog = document.querySelector<HTMLDialogElement>('#budget-dialog');
      const serviceSelect = document.querySelector<HTMLSelectElement>('#modal-servicio');
      const closeButton = document.querySelector<HTMLButtonElement>('.budget-dialog-close');
      const budgetLinks = document.querySelectorAll<HTMLElement>('[data-budget-service]');

      const closeBudgetDialog = () => {
        budgetDialog?.close();
        document.body.classList.remove('dialog-open');
      };

      budgetLinks.forEach((link) => {
        link.addEventListener('click', (event) => {
          if (!budgetDialog) return;
          event.preventDefault();
          if (serviceSelect) serviceSelect.value = link.dataset.budgetService ?? '';
          budgetDialog.showModal();
          document.body.classList.add('dialog-open');
        });
      });

      closeButton?.addEventListener('click', closeBudgetDialog);
      budgetDialog?.addEventListener('click', (event) => {
        if (event.target === budgetDialog) closeBudgetDialog();
      });
      budgetDialog?.addEventListener('close', () => document.body.classList.remove('dialog-open'));
    </script>
  </body>
</html>

<style>
  :root { --pine: #143d36; --aqua: #70d0c3; --paper: #f5f7f2; --ink: #153d36; }
  * { box-sizing: border-box; }
  img { max-width: 100%; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: 'DM Sans', sans-serif; }
  .wrap { width: min(1500px, calc(100% - 24px)); margin: 0 auto; }
  .site-header { background: var(--paper); border-bottom: 1px solid #dce4dc; }
  .header-content { width: min(1400px, calc(100% - 80px)); min-height: 104px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; column-gap: 90px; }
  .header-content .logo { justify-self: start; margin-left: -80px;}
  .header-content nav { justify-self: center; }
  .header-phone { justify-self: end; }
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--pine); text-decoration: none; }
  .logo-mark { display: none; }
  .logo-image { width: 64px; height: 64px; object-fit: contain; }
  .site-header .logo-image { width: 82px; height: 82px; }
  .logo-copy { display: flex; flex-direction: column; gap: 3px; }
  .logo-name { color: #91bd27; font: 800 32px/.9 'Manrope', sans-serif; letter-spacing: -2.2px; }
  .logo-tagline { color: #587068; font: 600 12px/1.2 'DM Sans', sans-serif; letter-spacing: -.2px; }
  nav { display: flex; gap: 42px; }
  nav a { color: #49665e; text-decoration: none; font-size: 14px; font-weight: 600; }
